#!/bin/sh
# postrm script for lliurex-hot-fixes.
#
# See: dh_installdeb(1).

set -e

# Summary of how this script can be called:
#        * <postrm> 'remove'
#        * <postrm> 'purge'
#        * <old-postrm> 'upgrade' <new-version>
#        * <new-postrm> 'failed-upgrade' <old-version>
#        * <new-postrm> 'abort-install'
#        * <new-postrm> 'abort-install' <old-version>
#        * <new-postrm> 'abort-upgrade' <old-version>
#        * <disappearer's-postrm> 'disappear' <overwriter>
#          <overwriter-version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package.

PKG="lliurex-hot-fixes"
ORIGINAL_CHROMIUM_FILE="/etc/chromium/master_preferences"
DIVERTED_PATH="/usr/share/lliurex-chromium/master_preferences.original"

ORIGINAL_EXTENSION_FILE="/usr/share/chromium/extensions/cimiefiiaegbelhefglklhhakcgmhkai.json"
DIVERTED_EXTENSION_FILE="/usr/share/lliurex-chromium/cimiefiiaegbelhefglklhhakcgmhkai.json"


case "$1" in
    purge|remove)
     		dpkg-divert --remove --package ${PKG} --rename --divert "$DIVERTED_PATH" "$ORIGINAL_CHROMIUM_FILE" || true
     		dpkg-divert --remove --package ${PKG} --rename --divert "$DIVERTED_EXTENSION_FILE" "$ORIGINAL_EXTENSION_FILE" || true
    ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;

    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
